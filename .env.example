# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is in .gitignore — it never goes to GitHub. This example file DOES go to GitHub,
# so never put a real key here.

# ---- App servers ----
APP_REPLICAS=3

# ---- Gateway ----
GATEWAY_PORT=8000
HEALTH_CHECK_INTERVAL_SEC=2
HEALTH_CHECK_FAIL_THRESHOLD=3

# ---- Rate limiting (token bucket) ----
RATE_LIMIT_TOKENS_PER_SEC=50
RATE_LIMIT_BUCKET_SIZE=100

# ---- Experiment mode: A = no protection, B = rule-based, C = AI-assisted ----
MODE=B

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- LLM (Week 10, optional) ----
# LLM_PROVIDER=anthropic   # anthropic | openai | ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_URL=http://localhost:11434
